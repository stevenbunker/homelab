%{ for config in configs ~}
%{ if !strcontains(current_config, "sso-session ${ config.role_name }") ~}
[ssoaccount_permission_set_productsession ${ config.role_name }]
sso_start_url = ${ start_url }
sso_region = ${ region }
sso_registration_scopes = sso:account:access
sso_role_name = ${ config.role_name }

%{ endif ~}
%{ if !strcontains(current_config, "profile ${config.permissionKey_account_product}") ~}
[profile ${ config.permissionKey_account_product }]
sso_session = ${ config.role_name }
sso_account_id = ${ config.account_id }
sso_role_name = ${ config.role_name }
region = ${ region }
output = json

%{ endif ~}
%{ endfor }