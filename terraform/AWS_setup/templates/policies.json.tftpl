{
    "tags": {
        "Project": {
            "tag_key": {
                "@@assign": "Project"
            }
        },
        "Environment": {
            "tag_key": {
                "@@assign": "Environment"
            },
            "tag_value": {
                "@@assign": [
                    "prod",
                    "test",
                    "shared",
                    "management"
                ]
            }
        },
        "OS_version": {
            "tag_key": {
                "@@assign": "OS_version"
            },
            "enforced_for": {
                "@@assign": [
                    "ec2:instance",
                    "ec2:image"
                ]
            }
        }
    }
}

